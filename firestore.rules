rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Default open access for app operational data to support both Firebase Auth & Staff Quick Accounts
    match /auth_logs/{logId} {
      allow read, write: if true;
    }

    match /guest_logs/{logId} {
      allow read, write: if true;
    }

    match /drugs/{drugId} {
      allow read, write: if true;
    }

    match /drug_groups/{groupId} {
      allow read, write: if true;
    }

    match /manual_interactions/{interactionId} {
      allow read, write: if true;
    }

    match /icd10/{code} {
      allow read, write: if true;
    }

    match /ingredients/{id} {
      allow read, write: if true;
    }

    match /ingredient_categories/{id} {
      allow read, write: if true;
    }

    match /excipients/{id} {
      allow read, write: if true;
    }

    match /excipient_categories/{id} {
      allow read, write: if true;
    }

    match /companies/{id} {
      allow read, write: if true;
    }

    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /adr_reports/{reportId} {
      allow read, write: if true;
    }

    match /adr_catalog/{itemId} {
      allow read, write: if true;
    }

    match /adr_categories/{catId} {
      allow read, write: if true;
    }

    match /config_titles/{itemId} {
      allow read, write: if true;
    }
    match /config_positions/{itemId} {
      allow read, write: if true;
    }
    match /config_specialties/{itemId} {
      allow read, write: if true;
    }
    match /config_roles/{itemId} {
      allow read, write: if true;
    }
    match /config_departments/{itemId} {
      allow read, write: if true;
    }
    match /role_permissions/{roleId} {
      allow read, write: if true;
    }
    match /title_permissions/{titleId} {
      allow read, write: if true;
    }

    match /patients/{maLk} {
      allow read, write: if true;
    }
    match /patient_groups/{groupId} {
      allow read, write: if true;
    }
    match /patient_drugs/{id} {
      allow read, write: if true;
    }
    match /patient_supplies/{id} {
      allow read, write: if true;
    }
    match /patient_subclinical/{id} {
      allow read, write: if true;
    }

    match /staff/{staffId} {
      allow read, write: if true;
    }

    match /calendar_events/{eventId} {
      allow read, write: if true;
    }

    match /notes/{noteId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /system_settings/{docId} {
      allow read, write: if true;
    }

    match /system_config/{docId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /social_posts/{postId} {
      allow read, write: if true;
    }

    match /social_likes/{likeId} {
      allow read, write: if true;
    }

    match /social_comments/{commentId} {
      allow read, write: if true;
    }

    match /todos/{todoId} {
      allow read, write: if true;
    }

    match /versions/{versionId} {
      allow read, write: if true;
    }

    match /y_khoa_documents/{docId} {
      allow read, write: if true;
    }

    match /y_khoa_categories/{catId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
